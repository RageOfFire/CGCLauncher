<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette, pulled from the server icon -->
    <SolidColorBrush x:Key="VoidBrush" Color="#14171F"/>
    <SolidColorBrush x:Key="StoneBrush" Color="#1F2430"/>
    <SolidColorBrush x:Key="StoneDarkBrush" Color="#191D28"/>
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#1B2030"/>
    <SolidColorBrush x:Key="ConsoleBrush" Color="#0E1018"/>
    <SolidColorBrush x:Key="BronzeBrush" Color="#5A3D24"/>
    <SolidColorBrush x:Key="GoldBrush" Color="#F0A93E"/>
    <SolidColorBrush x:Key="EmberBrush" Color="#FF6B2B"/>
    <SolidColorBrush x:Key="EmberHoverBrush" Color="#FF8142"/>
    <SolidColorBrush x:Key="EmberPressedBrush" Color="#D9551C"/>
    <SolidColorBrush x:Key="ParchmentBrush" Color="#EDE3D3"/>
    <SolidColorBrush x:Key="MutedSlateBrush" Color="#8B93A6"/>
    <SolidColorBrush x:Key="PillBrush" Color="#232838"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#3A2A12"/>
    <SolidColorBrush x:Key="ConsoleTextBrush" Color="#B5A887"/>

    <!-- Title bar buttons (minimize / maximize) -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MutedSlateBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource StoneDarkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Title bar close button - reddens on hover instead of just darkening -->
    <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MutedSlateBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C0392B"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Pill-shaped text box (username, install dir) -->
    <Style x:Key="PillTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource PillBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource ParchmentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pill-shaped combo box (version picker) -->
    <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{StaticResource PillBrush}" CornerRadius="14"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource PillBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,7,30,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleSite"
                                      Style="{StaticResource ComboBoxToggleButtonStyle}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Focusable="False" ClickMode="Press"/>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Path Data="M0,0 L6,6 L12,0" Stroke="{StaticResource MutedSlateBrush}"
                              StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                              IsHitTestVisible="False"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource StoneBrush}" BorderBrush="{StaticResource BronzeBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="4"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer MaxHeight="220" SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Applies to every ComboBoxItem app-wide (only the version picker uses one) -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource StoneDarkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themed checkbox ("Show snapshots") -->
    <Style x:Key="ThemedCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource MutedSlateBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Box" Width="16" Height="16" Background="{StaticResource PillBrush}"
                                BorderBrush="{StaticResource BronzeBrush}" BorderThickness="1" CornerRadius="3">
                            <Path x:Name="Check" Data="M2,8 L6,12 L14,2" Stroke="{StaticResource EmberBrush}"
                                  StrokeThickness="2" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain themed button (Browse...) -->
    <Style x:Key="ThemedButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PillBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource StoneBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The signature element: a faceted gem launch button. Flat color bands only - no
         blur or glow, matching the pixel-art cut-gem look rather than a soft halo. -->
    <Style x:Key="GemButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="96"/>
        <Setter Property="Height" Value="96"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="96" Height="96">
                        <Polygon x:Name="MainFacet" Points="48,0 96,34 79,96 17,96 0,34" Fill="{StaticResource EmberBrush}"/>
                        <Polygon Points="48,8 73,24 65,52 31,52 23,24" Fill="{StaticResource GoldBrush}"/>
                        <Polygon Points="40,30 40,66 68,48" Fill="{StaticResource StoneDarkBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainFacet" Property="Fill" Value="{StaticResource EmberHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="MainFacet" Property="Fill" Value="{StaticResource EmberPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
