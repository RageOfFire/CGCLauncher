<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== FONTS ===================== -->
    <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/VT323-Regular.ttf#VT323</FontFamily>

    <!-- ===================== PALETTE ===================== -->
    <SolidColorBrush x:Key="VoidBrush"        Color="#14171F"/>
    <SolidColorBrush x:Key="StoneMidBrush"    Color="#4A4F5C"/>
    <SolidColorBrush x:Key="StoneDarkBrush"   Color="#2E3240"/>
    <SolidColorBrush x:Key="MortarBrush"      Color="#1E2130"/>
    <SolidColorBrush x:Key="WoodBrush"        Color="#6B4423"/>
    <SolidColorBrush x:Key="WoodDarkBrush"    Color="#4A2E15"/>
    <SolidColorBrush x:Key="WoodLightBrush"   Color="#8B5E34"/>
    <SolidColorBrush x:Key="ParchmentBrush"   Color="#E8D9A0"/>
    <SolidColorBrush x:Key="ParchmentDarkBrush" Color="#C9BC7A"/>
    <SolidColorBrush x:Key="GoldBrush"        Color="#F0A93E"/>
    <SolidColorBrush x:Key="GoldDarkBrush"    Color="#B87820"/>
    <SolidColorBrush x:Key="EmberBrush"       Color="#FF6B2B"/>
    <SolidColorBrush x:Key="AmberBrush"       Color="#FFC107"/>
    <SolidColorBrush x:Key="AmberDarkBrush"   Color="#3A2A00"/>
    <SolidColorBrush x:Key="DarkTextBrush"    Color="#1A1208"/>
    <SolidColorBrush x:Key="MutedBrush"       Color="#8B93A6"/>
    <SolidColorBrush x:Key="ConsoleBgBrush"   Color="#D9C87A"/>

    <!-- ===================== STONE BRICK TILE ===================== -->
    <!-- Two-row brick offset tile, rendered purely in XAML geometry -->
    <DrawingBrush x:Key="StoneBrickBrush" TileMode="Tile" Viewport="0,0,64,32" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- Base fill -->
                <GeometryDrawing Brush="#3A3F4E">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,64,32"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Row 1 bricks -->
                <GeometryDrawing Brush="#454A5A">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="1,1,30,13"/>
                            <RectangleGeometry Rect="33,1,30,13"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Row 2 bricks offset by half -->
                <GeometryDrawing Brush="#424756">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="1,17,14,13"/>
                            <RectangleGeometry Rect="17,17,30,13"/>
                            <RectangleGeometry Rect="49,17,14,13"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Subtle highlight edges on row 1 -->
                <GeometryDrawing Brush="#52576A">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="1,1,30,1"/>
                            <RectangleGeometry Rect="33,1,30,1"/>
                            <RectangleGeometry Rect="1,1,1,13"/>
                            <RectangleGeometry Rect="33,1,1,13"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Subtle highlight edges on row 2 -->
                <GeometryDrawing Brush="#4E5368">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="1,17,14,1"/>
                            <RectangleGeometry Rect="17,17,30,1"/>
                            <RectangleGeometry Rect="49,17,14,1"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ===================== WOOD PLANK TILE ===================== -->
    <DrawingBrush x:Key="WoodPlankBrush" TileMode="Tile" Viewport="0,0,8,16" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#6B4423">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,16"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- plank grain line -->
                <GeometryDrawing Brush="#5A3819">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,15,8,1"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- highlight -->
                <GeometryDrawing Brush="#7A5030">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,1"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ===================== TITLE BAR BUTTONS ===================== -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#CC2222"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== PIXEL SIGN-IN BUTTON ===================== -->
    <Style x:Key="SignInButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ParchmentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Outer" Background="{StaticResource WoodDarkBrush}" Padding="2">
                        <Border x:Name="Inner" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Assets/logo.png" Width="18" Height="18" Margin="0,0,8,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Inner" Property="Background" Value="{StaticResource ParchmentDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Inner" Property="Background" Value="{StaticResource GoldBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== PIXEL LAUNCH BUTTON ===================== -->
    <Style x:Key="GemButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="130"/>
        <Setter Property="Height" Value="130"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Glow ring -->
                        <Ellipse x:Name="Glow" Width="140" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#66FF8C00" Offset="0.4"/>
                                    <GradientStop Color="#00FF8C00" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- Orange block face -->
                        <Border x:Name="BlockFace" Width="104" Height="104"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF9B30" Offset="0"/>
                                    <GradientStop Color="#E06000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#FF6B00" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/>
                            </Border.Effect>
                        </Border>
                        <!-- Block top face (isometric look) -->
                        <Border Width="104" Height="16" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFB84A" Offset="0"/>
                                    <GradientStop Color="#E07010" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- Pickaxe icon on block -->
                        <TextBlock Text="⛏" FontSize="52" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource WoodDarkBrush}" Margin="0,4,0,0"
                                   RenderOptions.ClearTypeHint="Enabled"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BlockFace" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BlockFace" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BlockFace" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== PARCHMENT TEXT BOX ===================== -->
    <Style x:Key="ParchmentTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ParchmentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource DarkTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- Sunken pixel border: dark outer, lighter inner -->
                    <Border Background="{StaticResource WoodDarkBrush}" Padding="2">
                        <Border Background="{StaticResource StoneDarkBrush}" Padding="2">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== PIXEL BROWSE BUTTON ===================== -->
    <Style x:Key="BrowseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ParchmentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{StaticResource WoodDarkBrush}" Padding="2">
                        <Border x:Name="Inner" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Inner" Property="Background" Value="{StaticResource ParchmentDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Inner" Property="Background" Value="{StaticResource GoldBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== PIXEL COMBO BOX ===================== -->
    <Style x:Key="ComboBoxToggleStyle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{StaticResource WoodDarkBrush}" Padding="2">
                        <Border Background="{StaticResource ParchmentBrush}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PixelComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource ParchmentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4,30,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border Background="{StaticResource WoodDarkBrush}" Padding="2">
                        <Border Background="{StaticResource StoneDarkBrush}" Padding="2">
                            <Grid Background="{StaticResource ParchmentBrush}">
                                <ToggleButton x:Name="ToggleSite"
                                              Style="{StaticResource ComboBoxToggleStyle}"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Focusable="False" ClickMode="Press" Opacity="0"/>
                                <ContentPresenter IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Text="▼" Foreground="{StaticResource WoodDarkBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,8,0" FontSize="12" IsHitTestVisible="False"/>
                                <Popup x:Name="Popup" Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False">
                                    <Border Background="{StaticResource WoodDarkBrush}" Padding="2">
                                        <Border Background="{StaticResource ParchmentBrush}" Padding="2">
                                            <ScrollViewer MaxHeight="200">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource GoldBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== PIXEL CHECKBOX ===================== -->
    <Style x:Key="PixelCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="18" Height="18" Background="{StaticResource ParchmentBrush}"
                                BorderBrush="{StaticResource WoodDarkBrush}" BorderThickness="2">
                            <TextBlock x:Name="Check" Text="✔" FontSize="13"
                                       Foreground="{StaticResource DarkTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
