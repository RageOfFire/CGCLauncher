<Window x:Class="CGCLauncher.Services.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in with Microsoft"
        Height="620" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <WebBrowser x:Name="Browser" Navigating="Browser_Navigating"/>
        <Border VerticalAlignment="Bottom" Background="#14171F" Padding="10,6">
            <TextBlock x:Name="StatusText" Foreground="#8B93A6" FontSize="12"
                       Text="Loading Microsoft login..." TextAlignment="Center"/>
        </Border>
    </Grid>
</Window>
