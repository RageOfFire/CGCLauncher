<Window x:Class="CGCLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CGCLauncher" Height="620" Width="540" MinHeight="580" MinWidth="500"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        Background="{StaticResource VoidBrush}" Icon="Assets/logo.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title bar -->
            <RowDefinition Height="*"/>     <!-- Body -->
            <RowDefinition Height="Auto"/>  <!-- Amber banner -->
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- TITLE BAR — wood plank texture with pixel font wordmark      -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Background="{StaticResource WoodPlankBrush}"
                BorderBrush="{StaticResource WoodDarkBrush}" BorderThickness="0,0,0,3"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Height="42">
                <!-- Left: logo + wordmark -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <Image Source="Assets/logo.png" Width="28" Height="28" Margin="0,0,8,0"/>
                    <TextBlock Text="CGCLAUNCHER" FontFamily="{StaticResource PixelFont}" FontSize="24"
                               Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="0" ShadowDepth="2" Direction="315" Opacity="1"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Right: sign-in + window controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button x:Name="SignInButton" Content="Sign in with Microsoft"
                            Style="{StaticResource SignInButtonStyle}"
                            Margin="0,0,8,0" Click="SignInButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="—" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="□" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕" Style="{StaticResource TitleBarCloseButtonStyle}" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- BODY — stone brick background with thick wood plank frame    -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1" Background="{StaticResource StoneBrickBrush}">

            <!-- Wood frame sides -->
            <Border BorderBrush="{StaticResource WoodPlankBrush}" BorderThickness="14,0,14,14">
                <!-- Inner shadow inset -->
                <Border BorderBrush="#AA000000" BorderThickness="2,0,2,2">
                    <Grid Margin="10,12,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Banner -->
                            <RowDefinition Height="Auto"/>  <!-- Logo -->
                            <RowDefinition Height="Auto"/>  <!-- Launch button -->
                            <RowDefinition Height="Auto"/>  <!-- Path row -->
                            <RowDefinition Height="*"/>     <!-- Console -->
                            <RowDefinition Height="Auto"/>  <!-- Bottom controls -->
                        </Grid.RowDefinitions>

                        <!-- BANNER -->
                        <Border Grid.Row="0" Margin="0,0,0,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#CC6B4423" Offset="0.15"/>
                                    <GradientStop Color="#CC6B4423" Offset="0.85"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Text="CRYSTALGEMCRAFT" FontFamily="{StaticResource PixelFont}" FontSize="28"
                                           Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="0" ShadowDepth="2" Direction="315" Opacity="1"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="LAUNCHER" FontFamily="{StaticResource PixelFont}" FontSize="28"
                                           Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="0" ShadowDepth="2" Direction="315" Opacity="1"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- LOGO -->
                        <Image Grid.Row="1" Source="Assets/logo.png" Width="100" Height="100"
                               HorizontalAlignment="Center" Margin="0,0,0,0"
                               RenderOptions.BitmapScalingMode="NearestNeighbor">
                            <Image.Effect>
                                <DropShadowEffect Color="#FF6B00" BlurRadius="22" ShadowDepth="0" Opacity="0.7"/>
                            </Image.Effect>
                        </Image>

                        <!-- LAUNCH BUTTON -->
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,2,0,8">
                            <Button x:Name="LaunchButton" Style="{StaticResource GemButtonStyle}" Click="LaunchButton_Click"/>
                            <TextBlock Text="LAUNCH MINECRAFT: CRYSTALGEMCRAFT"
                                       FontFamily="{StaticResource PixelFont}" FontSize="16"
                                       Foreground="{StaticResource ParchmentBrush}" HorizontalAlignment="Center"
                                       Margin="0,10,0,6" TextWrapping="Wrap" TextAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="0" ShadowDepth="1" Opacity="1"/>
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- Offline username — visible only when not signed in via Microsoft -->
                            <StackPanel x:Name="OfflineUsernamePanel" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,0,0,4">
                                <TextBlock Text="Name:" FontFamily="{StaticResource PixelFont}" FontSize="18"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBox x:Name="OfflineUsernameBox" Style="{StaticResource ParchmentTextBoxStyle}"
                                         Width="160" Text="Steve" FontSize="17"
                                         ToolTip="Used for offline/demo mode only. Sign in with Microsoft to use your real username."/>
                            </StackPanel>
                        </StackPanel>

                        <!-- INSTALL PATH ROW -->
                        <Grid Grid.Row="3" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstallDirTextBox" Grid.Column="0"
                                     Style="{StaticResource ParchmentTextBoxStyle}"
                                     IsReadOnly="True" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="BROWSE" Style="{StaticResource BrowseButtonStyle}"
                                    Click="BrowseButton_Click"/>
                        </Grid>

                        <!-- CONSOLE LOG -->
                        <Border Grid.Row="4" Margin="0,0,0,8"
                                Background="{StaticResource WoodDarkBrush}" Padding="2">
                            <Border Background="{StaticResource StoneDarkBrush}" Padding="2">
                                <Border Background="{StaticResource ConsoleBgBrush}" Padding="8,6">
                                    <TextBox x:Name="LogTextBox" IsReadOnly="True" Background="Transparent"
                                             BorderThickness="0" Foreground="{StaticResource DarkTextBrush}"
                                             FontFamily="{StaticResource PixelFont}" FontSize="16"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             MinHeight="80"/>
                                </Border>
                            </Border>
                        </Border>

                        <!-- VERSION + FILTER CHECKBOXES ROW -->
                        <Grid Grid.Row="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="VersionComboBox" Grid.Column="0"
                                      Style="{StaticResource PixelComboBoxStyle}"
                                      DisplayMemberPath="DisplayName" Margin="0,0,10,0"/>
                            <CheckBox x:Name="ShowSnapshotsCheckBox" Grid.Column="1"
                                      Content="Snapshot" Style="{StaticResource PixelCheckBoxStyle}"
                                      VerticalAlignment="Center" Margin="0,0,14,0"
                                      Checked="FilterCheckBox_Changed"
                                      Unchecked="FilterCheckBox_Changed"/>
                            <CheckBox x:Name="ShowOptiFineCheckBox" Grid.Column="2"
                                      Content="OptiFine" Style="{StaticResource PixelCheckBoxStyle}"
                                      VerticalAlignment="Center"
                                      Checked="FilterCheckBox_Changed"
                                      Unchecked="FilterCheckBox_Changed"/>
                        </Grid>

                    </Grid>
                </Border>
            </Border>

            <!-- Corner brackets (decorative, matching the server icon's frame) -->
            <Border IsHitTestVisible="False" Margin="14,0,14,14" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Width="20" Height="20"
                    BorderBrush="{StaticResource WoodDarkBrush}" BorderThickness="4,4,0,0"/>
            <Border IsHitTestVisible="False" Margin="14,0,14,14" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Width="20" Height="20"
                    BorderBrush="{StaticResource WoodDarkBrush}" BorderThickness="0,4,4,0"/>
            <Border IsHitTestVisible="False" Margin="14,0,14,14" HorizontalAlignment="Left"
                    VerticalAlignment="Bottom" Width="20" Height="20"
                    BorderBrush="{StaticResource WoodDarkBrush}" BorderThickness="4,0,0,4"/>
            <Border IsHitTestVisible="False" Margin="14,0,14,14" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" Width="20" Height="20"
                    BorderBrush="{StaticResource WoodDarkBrush}" BorderThickness="0,0,4,4"/>
        </Grid>

        <!-- ============================================================ -->
        <!-- AMBER DASHED BANNER — offline / auth state notice            -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" Background="{StaticResource AmberDarkBrush}" Padding="0,6">
            <Border.BorderBrush>
                <DrawingBrush TileMode="Tile" Viewport="0,0,24,4" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="#FFC107">
                                <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,12,4"/></GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#3A2A00">
                                <GeometryDrawing.Geometry><RectangleGeometry Rect="12,0,12,4"/></GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>0,3,0,3</Border.BorderThickness>
            <TextBlock x:Name="AuthStatusText"
                       Text="Offline mode — sign in to unlock full game"
                       FontFamily="{StaticResource PixelFont}" FontSize="18"
                       Foreground="{StaticResource AmberBrush}"
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="0" ShadowDepth="1" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>

    </Grid>
</Window>
